# Environment variables for the Kotak 360° Vehicle POC
# Copy this file to .env and fill in any overrides (defaults are pre-filled for POC)

# ── GCP ──────────────────────────────────────────────────────────
GCP_PROJECT_ID=testing-ratnesh
GCP_REGION=asia-south1
GCS_BUCKET_NAME=kotak-vehicles-360

# ── Firestore ─────────────────────────────────────────────────────
FIRESTORE_COLLECTION=vehicles

# ── Vertex AI / Imagen ────────────────────────────────────────────
IMAGEN_MODEL=imagegeneration@006
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
TOTAL_FRAMES=36

# ── Vehicle defaults ──────────────────────────────────────────────
DEFAULT_CAR_COLOR=Dashing Silver
